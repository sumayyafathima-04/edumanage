# Server Configuration
PORT=5000

# MongoDB Connection String
# For Local MongoDB: mongodb://127.0.0.1:27017/student_management_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/student_management_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/student_management_db

# JSON Web Token Secret Key
JWT_SECRET=your_jwt_secret_key_change_in_production
